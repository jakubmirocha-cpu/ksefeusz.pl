RewriteEngine On

# www → non-www (HTTP lub HTTPS)
RewriteCond %{HTTP_HOST} ^www\.ksefeusz\.pl [NC]
RewriteRule ^(.*)$ https://ksefeusz.pl/$1 [R=301,L]

# HTTP → HTTPS (jawna domena, nie %{HTTP_HOST} — żeby nie zachować www)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://ksefeusz.pl/$1 [R=301,L]

# /index.html → /
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ https://ksefeusz.pl/ [R=301,L]

# ============================================================
# Cache headers dla zasobów statycznych
# ============================================================

<IfModule mod_expires.c>
    ExpiresActive On

    # Biblioteki JS i CSS (wersjonowane przez ?v=)
    ExpiresByType application/javascript     "access plus 1 year"
    ExpiresByType text/javascript            "access plus 1 year"
    ExpiresByType text/css                   "access plus 1 year"

    # Obrazy i ikony
    ExpiresByType image/png                  "access plus 1 year"
    ExpiresByType image/jpeg                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon  "access plus 1 year"

    # Czcionki
    ExpiresByType font/woff                  "access plus 1 year"
    ExpiresByType font/woff2                 "access plus 1 year"
    ExpiresByType application/font-woff      "access plus 1 year"
    ExpiresByType application/font-woff2     "access plus 1 year"

    # HTML — krótki cache
    ExpiresByType text/html                  "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>

    # ------------------------------------------------------------
    # Content-Security-Policy — egzekwowany od 2026-10-02,
    # bez 'unsafe-inline' w script-src od wersji 1.9.0
    # ------------------------------------------------------------
    # Druga bariera po escapowaniu tekstu z XML: przeglądarka odmawia wczytania
    # i wysłania wszystkiego, czego ta polityka nie dopuszcza. Nowy zasób spoza
    # ksefeusz.pl (skrypt z CDN, font, zewnętrzne API) trzeba tu dopisać, inaczej
    # przeglądarka go zablokuje.
    #  - script-src 'self': żadnego kodu wpisanego w HTML (onclick="…", <script>
    #    bez src) — przeglądarka go nie wykona, nawet gdyby trafił na stronę.
    #    Cała obsługa strony jest w plikach .js
    #  - style-src 'unsafe-inline': atrybuty style w HTML; wstrzyknięty styl nie
    #    uruchamia kodu, a img-src 'self' nie pozwala nim niczego wysłać
    #  - connect-src: jedyne połączenie na zewnątrz to API białej listy MF —
    #    przeglądarka nie pozwoli wysłać danych nigdzie indziej
    #  - object-src blob:: pdfmake otwiera PDF do druku w nowej karcie z adresu
    #    blob:, a ta karta dziedziczy politykę strony. Chrome/Edge pokazują PDF
    #    także przy object-src 'none' (sprawdzone); blob: zostaje dla Firefoksa
    #    i Safari, w których tego nie sprawdzono
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://wl-api.mf.gov.pl; object-src blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

# Kompresja gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>